{
    "name": "italystrap/empress",
    "description": "Config driven for Auryn Injector the OOP way",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "overclokk",
            "email": "info@overclokk.net",
            "homepage": "https://www.italystrap.com",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "italystrap/config": "^2.12",
        "overclokk/auryn": "dev-master",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpspec/prophecy-phpunit": "^2.3",

        "squizlabs/php_codesniffer": "^3.7",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",

        "phpstan/phpstan": "^2.1",

        "phpbench/phpbench": "^1.2",
        "phpmetrics/phpmetrics": "^2.8",

        "infection/infection": "^0.29 || ^0.35",

        "rector/rector": "^2.0",
        "italystrap/debug": "dev-master",
        "italystrap/finder": "dev-master",
        "rector/swiss-knife": "^2.3",

        "friendsofphp/proxy-manager-lts": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ItalyStrap\\Empress\\": [
                "src/"
            ]
        },
        "files": [
            "namespace-bc-aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ItalyStrap\\Empress\\Tests\\": [
                "tests/src/",
                "tests/_data/fixtures/src/"
            ],
            "ItalyStrap\\Empress\\Tests\\Modules\\": "tests/_data/fixtures/modules/",
            "ItalyStrap\\Empress\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "suggest": {
        "friendsofphp/proxy-manager-lts": "Only if you want to add support for lazy loading classes",
        "italystrap/empress-cache": "Only if you want to cache the aggregated providers configuration in a PHP file"
    },
    "scripts": {
        "cs": [
            "@php vendor/bin/phpcs -p"
        ],
        "cs:fix": [
            "echo Fixing the package",
            "@php vendor/bin/phpcbf -p",
            "echo Fixing example.php",
            "@php vendor/bin/phpcbf example.php"
        ],
        "stan": [
            "@php ./vendor/bin/phpstan analyse --no-progress"
        ],
        "unit": [
            "@php vendor/bin/phpunit"
        ],
        "unit:debug": [
            "@php vendor/bin/phpunit --debug"
        ],
        "infection": [
            "@php vendor/bin/infection --threads=4"
        ],
        "bench": [
            "@php vendor/bin/phpbench run --report=performance"
        ],
        "metrics": [
            "@php vendor/bin/phpmetrics --report-html='./tests/_output/report' ./src"
        ],
        "insights": [
            "@php vendor/bin/phpinsights"
        ],
        "qa": [
            "@cs",
            "@stan",
            "@unit"
        ]
    },
    "support"    : {
        "issues": "https://github.com/ItalyStrap/empress/issues",
        "source": "https://github.com/ItalyStrap/empress"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        }
    }
}
