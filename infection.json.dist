{
  "source": {
    "directories": [
      "src"
    ]
  },
  "timeout": 10,
  "logs": {
    "text": "php://stdout"
  },
  "mutators": {
    "@default": true,
    "UnwrapArrayValues": {
      "ignore": [
        "ItalyStrap\\Empress\\ContainerBuilder::extend"
      ]
    }
  },
  "tmpDir": "tests\/_output",
  "testFramework": "phpunit"
}